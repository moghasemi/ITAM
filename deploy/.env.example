# Copy to .env and set real values. Never commit .env.
ITAM_DEBUG=0
ITAM_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
ITAM_ALLOWED_HOSTS=localhost,127.0.0.1
ITAM_CSRF_TRUSTED_ORIGINS=https://itam.example.local
ITAM_DB_ENGINE=sqlite
ITAM_DB_PATH=db.sqlite3
ITAM_SECURE_COOKIES=1
ITAM_USE_PROXY_SSL_HEADER=1
ITAM_PUBLIC_BASE_URL=https://itam.example.local
ITAM_ORG_NAME=اداره کل
