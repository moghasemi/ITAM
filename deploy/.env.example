# Production template: PostgreSQL + HTTPS reverse proxy.
# Copy to the project root as .env. Never commit the populated .env file.
ITAM_DEBUG=0
ITAM_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe_64
ITAM_ALLOWED_HOSTS=itam.example.local
ITAM_CSRF_TRUSTED_ORIGINS=https://itam.example.local
ITAM_USE_PROXY_SSL_HEADER=1
ITAM_SECURE_COOKIES=1
ITAM_PUBLIC_BASE_URL=https://itam.example.local
ITAM_ORG_NAME=اداره کل

ITAM_DB_ENGINE=postgresql
ITAM_DB_NAME=itam
ITAM_DB_USER=itam_app
ITAM_DB_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_DATABASE_PASSWORD
ITAM_DB_HOST=127.0.0.1
ITAM_DB_PORT=5432
ITAM_DB_TIMEOUT=10
